{
  "name": "@workstudio-plugins/html-editor",
  "version": "0.1.0",
  "private": true,
  "description": "WorkStudio HTML editor: CodeMirror editing, live preview view and save",
  "type": "module",
  "exports": {
    "./workstudio": "./dist/engine.js"
  },
  "workstudio": {
    "id": "html-editor",
    "label": "HTML 编辑器",
    "icon": "code",
    "pages": {
      "content": "dist/page/index.html",
      "settings": "dist/settings/index.html"
    },
    "claims": [
      {
        "extensions": [
          "html",
          "htm"
        ],
        "priority": 20
      }
    ],
    "skills": [
      "skills/html-editor"
    ]
  },
  "scripts": {
    "build": "vite build && vite build --config vite.engine.config.ts && workstudio-plugin .",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@workstudio/sdk": "file:../WorkStudio/packages/sdk",
    "parse5": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
